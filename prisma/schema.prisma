generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// The note tree — note, category, example, block, image — is held together by
// foreign keys the database now enforces. Every delete rule below matches what
// the actions in src/lib/actions/notes.ts already do by hand: deleting a note
// takes its categories, examples, blocks and images with it. Those hand-written
// deletes stay, because rows are only half the job — the image files on the
// volume have to be unlinked before their rows disappear, and no cascade can do
// that. What the cascades add is the guarantee that a delete which stops
// halfway, or a row inserted by a script, cannot leave an example pointing at a
// note that no longer exists.
//
// Every foreign key is indexed. SQLite does not do it on its own, and each one
// is queried directly — `where exampleId = ?` runs on every note view.

model Trade {
  id             String   @id @default(cuid())
  date           DateTime
  time           String?
  symbol         String
  market         String?
  side           String
  size           Float
  pnl            Float

  // What the trade stood to lose: the distance to the initial stop, in money.
  // It is the figure the journal was missing — a number of lots does not give
  // it, since the same size risks a different amount depending on where the
  // stop sits — and without it `rr` cannot be computed, which is why that
  // column is empty on all 88 imported trades.
  risk           Float?

  // Realised reward-to-risk, `pnl / risk`. Derived on save rather than typed:
  // a full loss is −1, a winner that made twice what it risked is 2. Still
  // nullable, for the trades taken before `risk` was recorded.
  rr             Float?
  setup          String
  emotion        String?
  preTradeNotes  String?
  postTradeNotes String?
  chartCluster   String?
  chartReverse   String?
  chartBox       String?
  chartTrading   String?
  createdAt      DateTime @default(now())

  noteImages NoteExampleImage[]
}

model ChecklistItem {
  id    String @id @default(cuid())
  group String
  label String
  order Int
}

model Note {
  id        String  @id @default(cuid())
  parentId  String?
  title     String
  order     Int     @default(0)
  // Folded in the sidebar. Kept here rather than in localStorage so the server
  // renders the tree already folded: reading it after hydration meant the page
  // painted every branch open for a moment before snapping shut.
  collapsed Boolean @default(false)

  // Whether the note's "Sans catégorie" bucket is folded. That bucket is not a
  // NoteCategory row — it is whatever is left over — so it has no row of its own
  // to carry the flag, and it lives here on the note instead.
  uncategorizedCollapsed Boolean  @default(false)
  createdAt              DateTime @default(now())

  parent     Note?          @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Note[]         @relation("NoteTree")
  categories NoteCategory[]
  examples   NoteExample[]
  blocks     NoteBlock[]

  @@index([parentId])
}

model NoteBlock {
  id         String   @id @default(cuid())
  noteId     String
  categoryId String?
  exampleId  String?
  type       String
  content    String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  note     Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  category NoteCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  example  NoteExample?  @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([categoryId])
  @@index([exampleId])
}

model NoteCategory {
  id     String @id @default(cuid())
  noteId String
  name   String
  order  Int    @default(0)

  // Folded, for the same reason as Note.collapsed.
  collapsed Boolean @default(false)

  note     Note          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  examples NoteExample[]
  blocks   NoteBlock[]

  @@index([noteId])
}

model NoteExample {
  id           String  @id @default(cuid())
  noteId       String
  categoryId   String?
  title        String
  caption      String?
  tags         String?
  hideText     Boolean @default(false)
  imagesPerRow Int     @default(2)

  // Three annotations the reader fills in by hand on an example: the
  // confirmations they saw, whether the setup turned out valid, and — when it
  // did not — why. `confirmations` and `invalidReasons` are JSON arrays of free
  // text, written by the same chip inputs that already store `tags`; `validity`
  // is "valid", "invalid", or null while nothing has been decided.
  confirmations  String?
  validity       String?
  invalidReasons String?

  // Folded, for the same reason as Note.collapsed.
  collapsed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  note     Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  category NoteCategory?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images   NoteExampleImage[]
  blocks   NoteBlock[]

  @@index([noteId])
  @@index([categoryId])
}

model NoteExampleImage {
  id        String  @id @default(cuid())
  exampleId String
  url       String
  caption   String?
  tradeId   String?
  order     Int     @default(0)

  // The capture's own pixel dimensions, so a tile can reserve its height before
  // the image arrives. Without them next/image is given `width={0} height={0}`
  // and every tile is zero-high until it loads — which made the page grow under
  // the reader, and made a click in the sidebar land on the wrong section.
  //
  // Nullable because they are not always knowable: the charts still hosted on
  // base44 are remote, and rows written before this column existed are filled
  // in by scripts/backfill-image-dimensions.ts on the next boot. A null simply
  // falls back to the old unreserved behaviour.
  width  Int?
  height Int?

  example NoteExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  // `tradeId` records that this image was imported from a trade; the note links
  // back to it. Deleting the trade therefore clears the link rather than the
  // row — the image belongs to the example, and it stays on the page with its
  // link gone. Whether the file behind it survives is decided elsewhere, by
  // counting what still points at that URL (see src/lib/imageFiles.ts).
  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@index([exampleId])
  @@index([tradeId])
}
