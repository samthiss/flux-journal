generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Trade {
  id           String   @id @default(cuid())
  date         DateTime
  time         String?
  symbol       String
  market       String?
  side         String
  size         Float
  pnl          Float
  rr           Float?
  setup        String
  emotion      String?
  preTradeNotes  String?
  postTradeNotes String?
  chartCluster String?
  chartReverse String?
  chartBox     String?
  chartTrading String?
  createdAt    DateTime @default(now())
}

model ChecklistItem {
  id    String @id @default(cuid())
  group String
  label String
  order Int
}

model ChecklistLog {
  id      String   @id @default(cuid())
  date    DateTime
  itemId  String
  checked Boolean  @default(false)

  @@unique([date, itemId])
}

model Note {
  id        String   @id @default(cuid())
  parentId  String?
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model NoteBlock {
  id         String   @id @default(cuid())
  noteId     String
  categoryId String?
  type       String
  content    String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model NoteCategory {
  id     String @id @default(cuid())
  noteId String
  name   String
  order  Int    @default(0)
}

model NoteExample {
  id           String   @id @default(cuid())
  noteId       String
  categoryId   String?
  title        String
  caption      String?
  tags         String?
  hideText     Boolean  @default(false)
  imagesPerRow Int      @default(2)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model NoteExampleImage {
  id        String  @id @default(cuid())
  exampleId String
  url       String
  caption   String?
  tradeId   String?
  order     Int     @default(0)
}
