{
  "name": "trading-journal",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && prisma db seed && next start -p ${PORT:-3000}",
    "lint": "eslint",
    "electron:dev": "ELECTRON_DEV_URL=http://localhost:3001 electron electron/main.js",
    "electron:prepare": "bash scripts/electron-prepare.sh",
    "electron:pack": "bash scripts/electron-pack.sh",
    "electron:build": "npm run electron:prepare && npm run electron:pack"
  },
  "build": {
    "appId": "com.samuelthissen.fluxjournal",
    "productName": "Flux Journal",
    "npmRebuild": false,
    "files": [
      "electron/main.js",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/resources/template.db",
        "to": "template.db"
      },
      {
        "from": "prisma/migrations",
        "to": "migrations"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance"
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "next": "16.2.11",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
